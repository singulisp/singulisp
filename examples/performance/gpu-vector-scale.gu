#[shader :thread-group-size [64 1 1]] (defn scale_values [(values : [& mut [GpuBuffer f32]]) (factor : f32)] -> ()
  (let index (gpu/thread-id-x))
  (when (< index (gpu-buf/len values))
    (gpu-buf/write values index (* (gpu-buf/read values index) factor))))

#[external] (defn main [] -> ()
  (let mut values : [Vec f32] (Vec/new))
  (Vec/push (& mut values) 1.0f)
  (Vec/push (& mut values) 2.0f)
  (Vec/push (& mut values) 3.0f)
  (Vec/push (& mut values) 4.0f)
  (let mut buffer (GpuBuffer/from-slice @gpu (& values)))
  (gpu/dispatch scale_values :threads [4 1 1] :args [(& mut buffer) 2.5f])
  (let result (GpuBuffer/to-vec buffer))
  (println! "{:.1} {:.1} {:.1} {:.1}"
    (Vec/get (& result) 0)
    (Vec/get (& result) 1)
    (Vec/get (& result) 2)
    (Vec/get (& result) 3)))

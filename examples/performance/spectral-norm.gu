; Adapted from the Singulisp benchmark suite for use as a standalone example.

(const VECTOR_SIZE : i64 256)
(const POWER_ROUNDS : i64 10)

#[fp-mode :fast]
(defn dot [(n : i64) (a : [& [Vec f64]]) (b : [& [Vec f64]])] -> f64
  (let mut sum 0.0)
  (let mut i : i64 0)
  (while (< i n)
    (set! sum (+ sum (* (Vec/get a i) (Vec/get b i))))
    (set! i (+ i 1)))
  sum)

#[fp-mode :fast]
(defn multiply-a
  [(n : i64)
   (source : [& [Vec f64]])
   (destination : [& mut [Vec f64]])] -> ()
  (let mut i : i64 0)
  (while (< i n)
    (let fi (to-f64 i))
    (let mut sum 0.0)
    (let mut j : i64 0)
    (while (< j n)
      (let fj (to-f64 j))
      (let fij (+ fi fj))
      (let denominator (+ (/ (* fij (+ fij 1.0)) 2.0) (+ fi 1.0)))
      (set! sum (+ sum (/ (Vec/get source j) denominator)))
      (set! j (+ j 1)))
    (Vec/set destination i sum)
    (set! i (+ i 1))))

#[fp-mode :fast]
(defn multiply-at
  [(n : i64)
   (source : [& [Vec f64]])
   (destination : [& mut [Vec f64]])] -> ()
  (let mut i : i64 0)
  (while (< i n)
    (let fi (to-f64 i))
    (let mut sum 0.0)
    (let mut j : i64 0)
    (while (< j n)
      (let fj (to-f64 j))
      (let fij (+ fi fj))
      (let denominator (+ (/ (* fij (+ fij 1.0)) 2.0) (+ fj 1.0)))
      (set! sum (+ sum (/ (Vec/get source j) denominator)))
      (set! j (+ j 1)))
    (Vec/set destination i sum)
    (set! i (+ i 1))))

(defn fill [(values : [& mut [Vec f64]]) (n : i64) (value : f64)] -> ()
  (let mut i : i64 0)
  (while (< i n)
    (Vec/push values value)
    (set! i (+ i 1))))

(defn spectral-norm [(n : i64)] -> f64
  (let mut u : [Vec f64] (Vec/new))
  (let mut v : [Vec f64] (Vec/new))
  (let mut temporary : [Vec f64] (Vec/new))
  (fill (& mut u) n 1.0)
  (fill (& mut v) n 0.0)
  (fill (& mut temporary) n 0.0)

  (let mut round : i64 0)
  (while (< round POWER_ROUNDS)
    (multiply-a n (& u) (& mut temporary))
    (multiply-at n (& temporary) (& mut v))
    (multiply-a n (& v) (& mut temporary))
    (multiply-at n (& temporary) (& mut u))
    (set! round (+ round 1)))

  (f64/sqrt (/ (dot n (& u) (& v))
               (dot n (& v) (& v)))))

#[external]
(defn main [] -> ()
  (println! "{:.9}" (spectral-norm VECTOR_SIZE)))
